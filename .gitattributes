# Source, requirements, snapshots and receipts are SHA256-bound. Preserve bytes
# on Windows and Linux; do not normalize existing line endings on checkout.
* -text whitespace=cr-at-eol
# Upstream snapshots are immutable, including upstream whitespace.
releases/v14.3/validation/inputs/** -whitespace
releases/v14.3/validation/network-review/*.download -whitespace
*.mrs binary
*.zip binary

# Preserve unified-diff context spaces and Go tabs as patch data.
releases/v14.3/research/ipv6-direct-fast-fail/*.patch -whitespace
releases/v14.3/research/auto-local-family/*.patch -whitespace
