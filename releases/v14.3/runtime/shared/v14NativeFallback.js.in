function v14NativeFallback(config, poolName, policies) {
  delete config["routeweaver-failover"];
  const groups = config["proxy-groups"];
  const byName = new Map(groups.map(group => [group.name, group]));
  const pool = byName.get(poolName);
  const marker = config["x-v14-generated"];
  if (pool.use && pool.use.length) {
    const warning = "本订阅由 proxy-providers 提供节点，沿用原分流，三档故障转移未启用。";
    marker.validationWarnings.push(warning);
    if (typeof console !== "undefined" && console.log) console.log("[V14] " + warning);
    return;
  }

  const occupied = new Set([...V14_BUILTINS, ...byName.keys(), ...config.proxies.map(node => node.name)]);
  function addGroup(label, fields) {
    let name = label;
    for (let i = 1; occupied.has(name); i++) {
      name = label + " [原生" + (i > 1 ? "-" + i : "") + "]";
    }
    occupied.add(name);
    const group = {name, ...fields};
    groups.push(group);
    byName.set(name, group);
    marker.groups.push(name);
    return name;
  }
  const manual = {
    type: "select", proxies: pool.proxies.slice(), "default-selected": "REJECT", "empty-fallback": "REJECT",
  };
  const backups = [1, 2, 3].map(slot => addGroup("故障转移" + slot, manual));
  function addFallback(label, members) {
    // The URL fragment gives this probe a separate cache key on the same HTTPS endpoint.
    return addGroup(label, {
      type: "fallback", proxies: members, hidden: true,
      url: V14.testUrl + "#routeweaver-failover", interval: 3, timeout: 3000, lazy: true,
      "expected-status": 204, "empty-fallback": "REJECT",
    });
  }
  const nodes = pool.proxies.filter(name => name !== "REJECT");
  const skips = [
    addFallback("跳过本档（1）", backups.slice(1)),
    addGroup("跳过本档（2）", {
      type: "select", proxies: [backups[2]], hidden: true, "empty-fallback": "REJECT",
    }),
  ];
  // An invalid saved choice falls back to the first member. Delegate to the
  // remaining tiers even while the outer group still considers this slot alive.
  for (const [index, skip] of skips.entries()) {
    const group = byName.get(backups[index]);
    group.proxies = [skip, ...nodes];
    group["default-selected"] = skip;
  }
  const choices = new Map(nodes.map(name => [name, addFallback(name + " ↻", [name, ...backups])]));
  // A missing saved selection resolves to the first member. With no healthy
  // backup this shared chain resolves to its own first member, REJECT.
  const missing = addFallback("主节点缺失 · 已选备用", ["REJECT", ...backups]);
  for (const policy of policies) {
    const group = byName.get(policy);
    group.proxies = [missing, ...group.proxies.map(name => choices.get(name) || name)];
    const preferred = choices.get(group["default-selected"]);
    if (preferred) group["default-selected"] = preferred;
  }
}
