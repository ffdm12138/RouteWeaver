+package sniffer
+
+import (
+	"errors"
+	"net"
+	"net/netip"
+	"testing"
+	"time"
+
+	N "github.com/metacubex/mihomo/common/net"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestRouteWeaverRejectsImpossibleTLSPrefixWithoutMoreBytes(t *testing.T) {
+	for _, data := range [][]byte{{0}, {'G'}, {0x17}, {0x16, 0}, {0x16, 4, 1}} {
+		if _, err := SniffTLS(data); !errors.Is(err, errNotTLS) {
+			t.Fatalf("impossible prefix %x was treated as incomplete: %v", data, err)
+		}
+	}
+}
+
+func TestRouteWeaverValidTLSPrefixesRemainIncompleteOrRecognized(t *testing.T) {
+	wire := makeTestTLSRecords(makeTestClientHello("fragmented.example.test", 12), 2, 19)
+	for cut := 0; cut <= len(wire); cut++ {
+		host, err := SniffTLS(wire[:cut])
+		if err != nil && !errors.Is(err, ErrNoClue) {
+			t.Fatalf("valid fragmented prefix %d rejected: %v", cut, err)
+		}
+		if host != nil && *host != "fragmented.example.test" {
+			t.Fatalf("domain changed: %q", *host)
+		}
+	}
+}
+
+func TestRouteWeaverFragmentedTLSKeepsOriginalReadBudget(t *testing.T) {
+	server, client := net.Pipe()
+	defer server.Close()
+	defer client.Close()
+	s, err := NewTLSSniffer(SnifferConfig{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	dispatcher := &Dispatcher{sniffers: []configuredSniffer{{Sniffer: s}}}
+	type result struct {
+		host string
+		err  error
+	}
+	finished := make(chan result, 1)
+	go func() {
+		host, _, err := dispatcher.sniffDomain(N.NewBufferedConn(server), &C.Metadata{DstIP: netip.MustParseAddr("2001:db8::42"), DstPort: 443})
+		finished <- result{host, err}
+	}()
+	wire := makeTestTLSRecords(makeTestClientHello("delayed.example.test", 0))
+	if _, err := client.Write(wire[:1]); err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(250 * time.Millisecond)
+	if _, err := client.Write(wire[1:]); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case got := <-finished:
+		if got.err != nil || got.host != "delayed.example.test" {
+			t.Fatalf("fragmented domain lost: %q %v", got.host, got.err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("sniffer failed to finish")
+	}
+}
