+}
diff --git a/Clash.Meta/adapter/outbound/direct_ipv6_error_test.go b/Clash.Meta/adapter/outbound/direct_ipv6_error_test.go
new file mode 100644
--- /dev/null
+++ b/Clash.Meta/adapter/outbound/direct_ipv6_error_test.go
@@ -0,0 +1,75 @@
+package outbound
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"os"
+	"syscall"
+	"testing"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestRouteWeaverDirectIPv6Error(t *testing.T) {
+	makeMeta := func(ip string) *C.Metadata {
+		return &C.Metadata{NetWork: C.TCP, DstIP: netip.MustParseAddr(ip), DstPort: 443}
+	}
+	wrapped := &net.OpError{Op: "dial", Net: "tcp", Err: &os.SyscallError{Syscall: "connect", Err: syscall.ENETUNREACH}}
+	direct := NewDirect()
+	hostname := makeMeta("2001:db8::42")
+	hostname.Host = "both-families.invalid"
+	udp := makeMeta("2001:db8::42")
+	udp.NetWork = C.UDP
+	inner := makeMeta("2001:db8::42")
+	inner.Type = C.INNER
+	tests := []struct {
+		name     string
+		metadata *C.Metadata
+		err      error
+		marked   bool
+	}{
+		{"ipv6 literal", makeMeta("2001:db8::42"), syscall.ENETUNREACH, true},
+		{"wrapped OS error", makeMeta("2001:db8::42"), wrapped, true},
+		{"IPv6 LAN route absent", makeMeta("fd00::42"), wrapped, true},
+		{"IPv4", makeMeta("192.0.2.42"), wrapped, false},
+		{"IPv4 mapped", makeMeta("::ffff:192.0.2.42"), wrapped, false},
+		{"hostname has precedence over cached IP", hostname, wrapped, false},
+		{"UDP excluded", udp, wrapped, false},
+		{"proxy transport through DIRECT excluded", inner, wrapped, false},
+		{"nil metadata", nil, wrapped, false},
+		{"unresolved", &C.Metadata{NetWork: C.TCP}, wrapped, false},
+		{"host unreachable", makeMeta("2001:db8::42"), syscall.EHOSTUNREACH, false},
+		{"connection refused", makeMeta("2001:db8::42"), syscall.ECONNREFUSED, false},
+		{"timeout", makeMeta("2001:db8::42"), context.DeadlineExceeded, false},
+		{"message text is insufficient", makeMeta("2001:db8::42"), errors.New("unreachable network"), false},
+		{"success", makeMeta("2001:db8::42"), nil, false},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			got := direct.directIPv6DialError(test.metadata, test.err)
+			if errors.Is(got, C.ErrDirectIPv6NetworkUnreachable) != test.marked {
+				t.Fatalf("marked=%v, want %v: %v", errors.Is(got, C.ErrDirectIPv6NetworkUnreachable), test.marked, got)
+			}
+			if test.err != nil && !errors.Is(got, test.err) {
+				t.Fatalf("original OS error lost: %v", got)
+			}
+			if !test.marked && got != test.err {
+				t.Fatalf("unrelated error changed: %v", got)
+			}
+		})
+	}
+	// An earlier failure must not leave any state that suppresses a new dial.
+	_ = direct.directIPv6DialError(makeMeta("2001:db8::42"), wrapped)
+	if got := direct.directIPv6DialError(makeMeta("2001:db8::42"), nil); got != nil {
+		t.Fatalf("success after route change affected: %v", got)
+	}
+}
+
+func TestRouteWeaverCompatibleUnchanged(t *testing.T) {
+	metadata := &C.Metadata{NetWork: C.TCP, DstIP: netip.MustParseAddr("2001:db8::42"), DstPort: 443}
+	if got := NewCompatible().directIPv6DialError(metadata, syscall.ENETUNREACH); got != syscall.ENETUNREACH {
+		t.Fatalf("COMPATIBLE adapter changed: %v", got)
+	}
+}
diff --git a/Clash.Meta/adapter/outbound/direct_ipv6_error_windows.go b/Clash.Meta/adapter/outbound/direct_ipv6_error_windows.go
new file mode 100644
--- /dev/null
+++ b/Clash.Meta/adapter/outbound/direct_ipv6_error_windows.go
@@ -0,0 +1,14 @@
+package outbound
+
+import (
+	"errors"
+	"syscall"
+
+	"golang.org/x/sys/windows"
+)
+
+func isDirectNetworkUnreachable(err error) bool {
+	// Winsock errors use WSAENETUNREACH (10051), distinct from Go's portable
+	// syscall.ENETUNREACH pseudo-errno on Windows.
+	return errors.Is(err, windows.WSAENETUNREACH) || errors.Is(err, syscall.ENETUNREACH)
+}
