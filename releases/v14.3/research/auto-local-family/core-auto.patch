+type localFamilyExchangeFunc func(context.Context, *D.Msg) (*D.Msg, error)
+
+func (f localFamilyExchangeFunc) ExchangeContext(ctx context.Context, m *D.Msg) (*D.Msg, error) {
+	return f(ctx, m)
