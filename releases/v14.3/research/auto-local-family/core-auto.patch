+)
+
+func TestRouteWeaverLocalDNSResponseFiltering(t *testing.T) {
+	oldFor, oldDefault := localFamilyStateFor, localFamilyStateDefault
+	oldEnabled := dialer.LocalFamilyAutoEnabled()
+	dialer.SetLocalFamilyAuto(true)
+	t.Cleanup(func() {
+		localFamilyStateFor = oldFor
+		localFamilyStateDefault = oldDefault
+		dialer.SetLocalFamilyAuto(oldEnabled)
+	})
+	state := "no-local-v6"
+	localFamilyStateDefault = func() dialer.LocalFamilySnapshot { return dialer.LocalFamilySnapshot{State: state} }
+	localFamilyStateFor = func(ip netip.Addr, _ string) dialer.LocalFamilySnapshot {
+		if ip == netip.MustParseAddr("2001:db8:2::1") {
+			return dialer.LocalFamilySnapshot{State: "local-v6-usable"}
+		}
+		return dialer.LocalFamilySnapshot{State: state}
+	}
+	req := new(D.Msg)
+	req.SetQuestion("test.example.", D.TypeAAAA)
+	resp := new(D.Msg)
+	resp.SetReply(req)
