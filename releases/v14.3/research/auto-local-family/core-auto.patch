+func TestRouteWeaverLocalDNSRequiresConfirmedIPv4Alternative(t *testing.T) {
+	ctx := context.Background()
+	positive := localFamilyExchangeFunc(func(ctx context.Context, q *D.Msg) (*D.Msg, error) {
+		if q.Question[0].Name != "same.example." || q.Question[0].Qtype != D.TypeA {
+			t.Fatal("wrong name/family", q)
+		}
+		if deadline, ok := ctx.Deadline(); !ok || time.Until(deadline) > 251*time.Millisecond {
+			t.Fatal("unbounded lookup")
+		}
+		response := new(D.Msg)
+		response.SetReply(q)
+		response.Answer = []D.RR{&D.A{Hdr: D.RR_Header{Name: q.Question[0].Name, Rrtype: D.TypeA, Class: D.ClassINET}, A: net.ParseIP("192.0.2.1")}}
+		return response, nil
+	})
+	if !localFamilyHasIPv4Alternative(ctx, "same.example", positive) {
+		t.Fatal("confirmed A ignored")
+	}
+	for _, backend := range []localFamilyExchanger{
+		nil,
+		localFamilyExchangeFunc(func(context.Context, *D.Msg) (*D.Msg, error) { return nil, errors.New("DNS unavailable") }),
+		localFamilyExchangeFunc(func(_ context.Context, q *D.Msg) (*D.Msg, error) { r := new(D.Msg); r.SetReply(q); return r, nil }),
+		localFamilyExchangeFunc(func(_ context.Context, q *D.Msg) (*D.Msg, error) {
+			r := new(D.Msg)
+			r.SetRcode(q, D.RcodeServerFailure)
+			return r, nil
+		}),
+	} {
+		if localFamilyHasIPv4Alternative(ctx, "same.example", backend) {
+			t.Fatal("unknown or IPv6-only service lost")
+		}
+	}
+	canceled, cancel := context.WithCancel(ctx)
+	cancel()
+	if localFamilyHasIPv4Alternative(canceled, "same.example", positive) {
+		t.Fatal("canceled evidence accepted")
+	}
+	for i := 0; i < cap(localFamilyAlternativeSlots); i++ {
+		localFamilyAlternativeSlots <- struct{}{}
+	}
+	got := localFamilyHasIPv4Alternative(ctx, "same.example", positive)
+	for i := 0; i < cap(localFamilyAlternativeSlots); i++ {
+		<-localFamilyAlternativeSlots
+	}
+	if got {
+		t.Fatal("saturated lookup should preserve IPv6")
+	}
+}
