+package dns
+
+// RouteWeaver conditional INGRESS address-family handling. Internal resolvers
+// used to connect to nodes/proxy exits are deliberately not filtered here.
+import (
+	"context"
+	"github.com/metacubex/mihomo/component/dialer"
+	D "github.com/miekg/dns"
+	"net/netip"
+	"strings"
+	"time"
+)
+
+var localFamilyStateFor = dialer.LocalFamilyFor
+var localFamilyStateDefault = dialer.LocalFamilyDefault
+
+func localFamilyNameExcluded(name string) bool {
+	host := strings.TrimSuffix(strings.ToLower(name), ".")
+	if !strings.Contains(host, ".") {
+		return true
+	}
+	for _, suffix := range []string{".local", ".lan", ".localdomain", ".home.arpa", ".in-addr.arpa", ".ip6.arpa"} {
+		if strings.HasSuffix(host, suffix) {
+			return true
+		}
+	}
+	return false
+}
+
+func localFamilySuppressVirtualAAAA(name string) bool {
+	return !localFamilyNameExcluded(name) && localFamilyStateDefault().State == "no-local-v6"
+}
+
+func localFamilyFilterResponse(request *D.Msg, response *D.Msg) *D.Msg {
+	if !dialer.LocalFamilyAutoEnabled() || response == nil || len(request.Question) != 1 ||
+		localFamilyNameExcluded(request.Question[0].Name) {
+		return response
+	}
+	q := request.Question[0]
+	if q.Qtype != D.TypeAAAA {
+		return response
+	}
+	// Preserve private/loopback/link-local addresses. Per-address egress
+	// selection prevents a missing default IPv6 source from suppressing a
+	// routed IPv6 address available through another controlled interface.
+	var filtered []D.RR
+	changed := false
+	for _, answer := range response.Answer {
+		if a, ok := answer.(*D.AAAA); ok {
+			ip, valid := netip.AddrFromSlice(a.AAAA)
+			if valid && ip.Is6() && !ip.Is4In6() && !ip.IsPrivate() && !ip.IsLoopback() && !ip.IsLinkLocalUnicast() &&
+				localFamilyStateFor(ip, "").State == "no-local-v6" {
+				changed = true
+				continue
+			}
+		}
+		filtered = append(filtered, answer)
+	}
+	if !changed {
+		return response
+	}
+	result := response.Copy()
+	result.Answer = nil
+	for _, rr := range filtered {
+		if sig, ok := rr.(*D.RRSIG); ok && sig.TypeCovered == D.TypeAAAA {
+			continue
+		}
+		result.Answer = append(result.Answer, rr)
+	}
+	// Modified DNS data cannot retain a claim of DNSSEC authentication.
+	result.AuthenticatedData = false
+	return result
+}
+
+// Query only the already requested name, through its same internal resolver
+// and nameserver-policy. No external canary, guessed mapping or global cache.
+// Saturation/deadline/error means unknown: preserve IPv6 instead of disabling
+// an IPv6-only service that could still be reached through a chosen proxy.
+var localFamilyAlternativeSlots = make(chan struct{}, 8)
+
+type localFamilyExchanger interface {
+	ExchangeContext(context.Context, *D.Msg) (*D.Msg, error)
+}
+
+func localFamilyHasIPv4Alternative(ctx context.Context, name string, backend localFamilyExchanger) bool {
+	if backend == nil {
+		return false
+	}
+	select {
+	case localFamilyAlternativeSlots <- struct{}{}:
+	default:
+		return false
+	}
+	defer func() { <-localFamilyAlternativeSlots }()
+	limited, cancel := context.WithTimeout(ctx, 250*time.Millisecond)
+	defer cancel()
+	query := new(D.Msg)
+	query.SetQuestion(D.Fqdn(name), D.TypeA)
+	response, err := backend.ExchangeContext(limited, query)
+	if err != nil || limited.Err() != nil || response == nil || response.Rcode != D.RcodeSuccess {
+		return false
+	}
+	for _, answer := range response.Answer {
+		if a, ok := answer.(*D.A); ok && a.A.To4() != nil && !a.A.IsUnspecified() {
+			return true
+		}
+	}
+	return false
+}
