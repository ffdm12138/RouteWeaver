+package dialer
+
+// RouteWeaver auto-local-family-r1. All decisions concern the local socket
+// egress, never the remote destination reached through an already chosen proxy.
+// No canary traffic, persistent network blacklist, node switching or routing
+// changes are introduced. Unknown evidence keeps the ordinary dual-stack path.
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"net/netip"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+)
+
+const LocalFamilyRevision = "auto-local-family-r1"
+const localFamilySourceTTL = time.Second
+const localFamilyPositiveTTL = 30 * time.Second
+const localFamilyNegativeTTL = 5 * time.Second
+
+// LocalFamilySnapshot is a bounded statement about one local egress, not a
+// claim that all IPv6 destinations or an arbitrary proxy's exit are reachable.
+type LocalFamilySnapshot struct {
+	State         string `json:"state"`
+	Reason        string `json:"reason"`
+	Interface     string `json:"interface,omitempty"`
+	HasIPv4Source bool   `json:"has-ipv4-source"`
+	HasIPv6Source bool   `json:"has-ipv6-source"`
+	Generation    uint64 `json:"generation"`
+	signature     string
+}
+
+type localFamilyEvidence struct {
+	source        LocalFamilySnapshot
+	sourceUntil   time.Time
+	successUntil  time.Time
+	negativeUntil time.Time
+	failures      map[netip.Prefix]time.Time
+}
+
+var localFamilyEnabled atomic.Bool
+var localFamilyGeneration atomic.Uint64
+var localFamilyMu sync.Mutex
+var localFamilyEvidenceByInterface = make(map[string]*localFamilyEvidence)
+
+// Tests replace only this side-effect-free observation seam; production uses
+// the selected interface and its real addresses, not all virtual interfaces.
+var localFamilyReadInterface = readLocalFamilyInterface
+var localFamilyNow = time.Now
+
+func SetLocalFamilyAuto(enabled bool) {
+	if localFamilyEnabled.Swap(enabled) != enabled {
+		InvalidateLocalFamily()
+	}
+}
+
+func LocalFamilyAutoEnabled() bool { return localFamilyEnabled.Load() }
+
+func InvalidateLocalFamily() {
+	localFamilyMu.Lock()
+	defer localFamilyMu.Unlock()
+	localFamilyGeneration.Add(1)
+	localFamilyEvidenceByInterface = make(map[string]*localFamilyEvidence)
+}
+
+func readLocalFamilyInterface(name string) (LocalFamilySnapshot, error) {
+	iface, err := net.InterfaceByName(name)
+	if err != nil {
+		return LocalFamilySnapshot{}, err
+	}
+	addresses, err := iface.Addrs()
+	if err != nil {
+		return LocalFamilySnapshot{}, err
+	}
+	s := LocalFamilySnapshot{State: "unknown", Reason: "no-reachability-evidence", Interface: name}
+	parts := []string{fmt.Sprint(iface.Index), fmt.Sprint(iface.Flags)}
+	for _, address := range addresses {
+		parts = append(parts, address.String())
+		prefix, err := netip.ParsePrefix(address.String())
+		if err != nil {
+			continue
+		}
+		ip := prefix.Addr().Unmap()
+		if ip.IsLoopback() || ip.IsLinkLocalUnicast() || !ip.IsGlobalUnicast() {
+			continue
+		}
+		// ULA on a real selected egress is deliberately retained: a managed
+		// NAT66/tunnel can make it useful. ULA alone is not positive evidence.
+		if ip.Is4() {
+			s.HasIPv4Source = true
+		} else {
+			s.HasIPv6Source = true
+		}
+	}
+	sort.Strings(parts)
+	s.signature = strings.Join(parts, "|")
+	if iface.Flags&net.FlagUp == 0 {
+		s.Reason = "interface-down"
+		return s, nil
+	}
+	if !s.HasIPv6Source {
+		s.State = "no-local-v6"
+		s.Reason = "selected-interface-has-no-routable-ipv6-source"
+	}
+	return s, nil
+}
+
+func selectedLocalFamilyInterface(destination netip.Addr, explicit string) string {
+	if !destination.IsValid() {
+		destination = netip.IPv6Unspecified()
+	}
+	if explicit != "" {
+		return explicit
+	}
+	if name := DefaultInterface.Load(); name != "" {
+		return name
+	}
+	if finder := DefaultInterfaceFinder.Load(); finder != nil {
+		return finder.FindInterfaceName(destination)
+	}
+	return ""
+}
+
+// LocalFamilyFor is evaluated at DNS/dial time. Network-monitor notifications
+// invalidate immediately; address changes are re-read within one second even
+// if a host misses a notification. A single failed destination never poisons
+// the egress state, and stale evidence never applies to another interface.
+func LocalFamilyFor(destination netip.Addr, explicit string) LocalFamilySnapshot {
+	unknown := LocalFamilySnapshot{State: "unknown", Reason: "disabled", Generation: localFamilyGeneration.Load()}
+	if !localFamilyEnabled.Load() {
+		return unknown
+	}
+	if DefaultSocketHook != nil {
+		unknown.Reason = "socket-hook-owned-egress-needs-host-capability"
+		return unknown
+	}
+	name := selectedLocalFamilyInterface(destination, explicit)
+	if name == "" || name == "<invalid>" || name == "<nil>" {
+		unknown.Reason = "egress-interface-unavailable"
+		return unknown
+	}
+	now := localFamilyNow()
+	localFamilyMu.Lock()
+	defer localFamilyMu.Unlock()
+	generation := localFamilyGeneration.Load()
+	entry := localFamilyEvidenceByInterface[name]
+	if entry == nil || !now.Before(entry.sourceUntil) {
+		source, err := localFamilyReadInterface(name)
+		if err != nil {
+			unknown.Reason = "egress-observation-failed"
+			return unknown
+		}
+		source.Generation = generation
+		if entry == nil || entry.source.signature != source.signature {
+			entry = &localFamilyEvidence{failures: make(map[netip.Prefix]time.Time)}
+		}
+		entry.source = source
+		entry.sourceUntil = now.Add(localFamilySourceTTL)
+		if len(localFamilyEvidenceByInterface) >= 16 && localFamilyEvidenceByInterface[name] == nil {
+			localFamilyEvidenceByInterface = make(map[string]*localFamilyEvidence)
+		}
+		localFamilyEvidenceByInterface[name] = entry
+	}
+	result := entry.source
+	result.Generation = generation
+	if result.State == "no-local-v6" {
+		return result
+	}
+	if now.Before(entry.successUntil) {
+		result.State = "local-v6-usable"
+		result.Reason = "recent-local-ipv6-tcp-success"
+		return result
+	}
+	if now.Before(entry.negativeUntil) {
+		result.State = "no-local-v6"
+		result.Reason = "bounded-multiple-prefix-network-unreachable"
+		return result
+	}
+	return result
+}
+
+func LocalFamilyDefault() LocalFamilySnapshot {
+	return LocalFamilyFor(netip.IPv6Unspecified(), "")
+}
+
+func localFamilyObserve(snapshot LocalFamilySnapshot, destination netip.Addr, network string, err error) {
+	if !localFamilyEnabled.Load() || !strings.HasPrefix(network, "tcp") ||
+		!destination.Is6() || destination.Is4In6() || destination.IsLoopback() ||
+		destination.IsLinkLocalUnicast() || destination.IsPrivate() || snapshot.Interface == "" {
+		return
+	}
+	now := localFamilyNow()
+	localFamilyMu.Lock()
+	defer localFamilyMu.Unlock()
+	if snapshot.Generation != localFamilyGeneration.Load() {
+		return
+	}
+	entry := localFamilyEvidenceByInterface[snapshot.Interface]
+	if entry == nil || entry.source.signature != snapshot.signature {
+		return
+	}
+	if err == nil {
+		entry.successUntil = now.Add(localFamilyPositiveTTL)
+		entry.negativeUntil = time.Time{}
+		entry.failures = make(map[netip.Prefix]time.Time)
+		return
+	}
+	// Deadline, refusal, reset, DNS error and cancellation are NOT evidence
+	// of a missing IPv6 exit. Require distinct native unreachable prefixes.
+	if !errors.Is(err, syscall.ENETUNREACH) {
+		return
+	}
+	for prefix, until := range entry.failures {
+		if !now.Before(until) {
+			delete(entry.failures, prefix)
+		}
+	}
+	prefix := netip.PrefixFrom(destination, 48).Masked()
+	if len(entry.failures) < 16 {
+		entry.failures[prefix] = now.Add(localFamilyNegativeTTL)
+	} else if _, exists := entry.failures[prefix]; exists {
+		entry.failures[prefix] = now.Add(localFamilyNegativeTTL)
+	}
+	if len(entry.failures) >= 2 && !now.Before(entry.successUntil) {
+		entry.negativeUntil = now.Add(localFamilyNegativeTTL)
+	}
+}
+
+func localFamilyCandidates(ips []netip.Addr, opt option) []netip.Addr {
+	if !localFamilyEnabled.Load() || opt.network != 0 || opt.prefer == 6 || DefaultSocketHook != nil {
+		return ips
+	}
+	// A proxy-provided netDialer is not a local transport; do not apply local
+	// source observations to another hop or a remote IPv6 destination.
+	if opt.netDialer != nil {
+		if _, ok := opt.netDialer.(*net.Dialer); !ok {
+			return ips
+		}
+	}
+	have4 := false
+	for _, ip := range ips {
+		if ip.Unmap().Is4() {
+			have4 = true
+			break
+		}
+	}
+	if !have4 {
+		return ips
+	} // keep IPv6-only names, explicit/literal IPv6 and their errors
+	kept := make([]netip.Addr, 0, len(ips))
+	for _, ip := range ips {
+		if ip.Is6() && !ip.Is4In6() && !ip.IsPrivate() && !ip.IsLoopback() && !ip.IsLinkLocalUnicast() &&
+			LocalFamilyFor(ip, opt.interfaceName).State == "no-local-v6" {
+			continue
+		}
+		kept = append(kept, ip)
+	}
+	return kept
+}
