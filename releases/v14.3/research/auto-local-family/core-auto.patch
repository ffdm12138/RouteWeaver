+package dialer
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"reflect"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func familyFixture(t *testing.T, has6 bool) (*time.Time, *LocalFamilySnapshot) {
+	t.Helper()
+	oldRead, oldNow := localFamilyReadInterface, localFamilyNow
+	oldInterface := DefaultInterface.Load()
+	oldEnabled := LocalFamilyAutoEnabled()
+	now := time.Unix(1000, 0)
+	source := LocalFamilySnapshot{State: "unknown", Reason: "no-reachability-evidence", Interface: "test-egress", HasIPv4Source: true, HasIPv6Source: has6, signature: "network-A"}
+	if !has6 {
+		source.State = "no-local-v6"
+		source.Reason = "selected-interface-has-no-routable-ipv6-source"
+	}
+	localFamilyReadInterface = func(name string) (LocalFamilySnapshot, error) { s := source; s.Interface = name; return s, nil }
+	localFamilyNow = func() time.Time { return now }
+	DefaultInterface.Store("test-egress")
+	SetLocalFamilyAuto(true)
+	InvalidateLocalFamily()
+	t.Cleanup(func() {
+		localFamilyReadInterface = oldRead
+		localFamilyNow = oldNow
+		DefaultInterface.Store(oldInterface)
+		SetLocalFamilyAuto(oldEnabled)
+		InvalidateLocalFamily()
+	})
+	return &now, &source
+}
+
+func TestRouteWeaverLocalFamilySourcesAndCandidates(t *testing.T) {
+	_, source := familyFixture(t, false)
+	if got := LocalFamilyDefault(); got.State != "no-local-v6" {
+		t.Fatal(got)
+	}
+	ips := []netip.Addr{netip.MustParseAddr("192.0.2.1"), netip.MustParseAddr("2001:db8:1::1"), netip.MustParseAddr("fd00::1"), netip.MustParseAddr("::1")}
+	want := []netip.Addr{ips[0], ips[2], ips[3]}
+	if got := localFamilyCandidates(ips, option{}); !reflect.DeepEqual(got, want) {
+		t.Fatal(got)
+	}
+	for _, opt := range []option{{network: 6}, {network: 4}, {prefer: 6}} {
+		if got := localFamilyCandidates(ips, opt); !reflect.DeepEqual(got, ips) {
+			t.Fatal("explicit family overridden", got)
+		}
+	}
+	if got := localFamilyCandidates(ips[1:2], option{}); !reflect.DeepEqual(got, ips[1:2]) {
+		t.Fatal("IPv6-only destination lost")
+	}
+	SetLocalFamilyAuto(false)
+	if got := localFamilyCandidates(ips, option{}); !reflect.DeepEqual(got, ips) {
+		t.Fatal("disabled changed candidates")
+	}
+	SetLocalFamilyAuto(true)
+	source.State = "unknown"
+	source.HasIPv6Source = true
+	source.signature = "network-B"
+	InvalidateLocalFamily()
+	if got := LocalFamilyDefault(); got.State != "unknown" {
+		t.Fatal("GUA is not proof of reachability", got)
+	}
+	if got := localFamilyCandidates(ips, option{}); !reflect.DeepEqual(got, ips) {
+		t.Fatal("unknown suppressed IPv6")
+	}
+}
+
+func TestRouteWeaverLocalFamilyRequiresIndependentHardFailures(t *testing.T) {
+	now, _ := familyFixture(t, true)
+	ip1 := netip.MustParseAddr("2001:db8:1::1")
+	ip2 := netip.MustParseAddr("2001:db8:2::1")
+	for _, err := range []error{context.DeadlineExceeded, context.Canceled, syscall.ECONNREFUSED, errors.New("network unreachable string only")} {
+		localFamilyObserve(LocalFamilyDefault(), ip1, "tcp", err)
+	}
+	if got := LocalFamilyDefault(); got.State != "unknown" {
+		t.Fatal(got)
+	}
+	localFamilyObserve(LocalFamilyDefault(), ip1, "tcp", syscall.ENETUNREACH)
+	localFamilyObserve(LocalFamilyDefault(), netip.MustParseAddr("2001:db8:1::2"), "tcp", syscall.ENETUNREACH)
+	if got := LocalFamilyDefault(); got.State != "unknown" {
+		t.Fatal("same prefix counted twice", got)
+	}
+	localFamilyObserve(LocalFamilyDefault(), ip2, "tcp", syscall.ENETUNREACH)
+	if got := LocalFamilyDefault(); got.State != "no-local-v6" {
+		t.Fatal(got)
+	}
+	*now = now.Add(localFamilyNegativeTTL + time.Millisecond)
+	if got := LocalFamilyDefault(); got.State != "unknown" {
+		t.Fatal("expired evidence retained", got)
+	}
+}
+
+func TestRouteWeaverLocalFamilySuccessIsBoundedAndUDPIsNotProof(t *testing.T) {
+	now, _ := familyFixture(t, true)
+	ip := netip.MustParseAddr("2001:db8:10::1")
+	localFamilyObserve(LocalFamilyDefault(), ip, "udp", nil)
+	if got := LocalFamilyDefault(); got.State != "unknown" {
+		t.Fatal("UDP socket creation was treated as remote success", got)
+	}
+	localFamilyObserve(LocalFamilyDefault(), ip, "tcp6", nil)
+	if got := LocalFamilyDefault(); got.State != "local-v6-usable" {
+		t.Fatal(got)
+	}
+	for _, s := range []string{"2001:db8:1::1", "2001:db8:2::1"} {
+		localFamilyObserve(LocalFamilyDefault(), netip.MustParseAddr(s), "tcp", syscall.ENETUNREACH)
+	}
+	if got := LocalFamilyDefault(); got.State != "local-v6-usable" {
+		t.Fatal("failure overrode recent success", got)
+	}
+	*now = now.Add(localFamilyPositiveTTL + time.Millisecond)
+	if got := LocalFamilyDefault(); got.State != "unknown" {
+		t.Fatal("positive evidence never expired", got)
+	}
+}
+
+func TestRouteWeaverLocalFamilyNetworkChangeDiscardsOldResults(t *testing.T) {
+	now, source := familyFixture(t, true)
+	ip := netip.MustParseAddr("2001:db8:1::1")
+	old := LocalFamilyDefault()
+	localFamilyObserve(old, ip, "tcp", nil)
+	source.signature = "network-B"
+	source.HasIPv6Source = false
+	source.State = "no-local-v6"
+	*now = now.Add(localFamilySourceTTL + time.Millisecond)
+	if got := LocalFamilyDefault(); got.State != "no-local-v6" {
+		t.Fatal("source change ignored", got)
+	}
+	source.signature = "network-C"
+	source.HasIPv6Source = true
+	source.State = "unknown"
+	InvalidateLocalFamily()
+	if got := LocalFamilyDefault(); got.State != "unknown" {
+		t.Fatal(got)
+	}
+	localFamilyObserve(old, ip, "tcp", nil)
+	if got := LocalFamilyDefault(); got.State != "unknown" {
+		t.Fatal("old network result leaked into new generation", got)
+	}
+}
+
+type familyRemoteDialer struct{}
+
+func (familyRemoteDialer) DialContext(context.Context, string, string) (net.Conn, error) {
+	return nil, errors.New("not invoked")
+}
+
+func TestRouteWeaverLocalFamilyDoesNotRestrictRemoteDialer(t *testing.T) {
+	familyFixture(t, false)
+	ips := []netip.Addr{netip.MustParseAddr("192.0.2.1"), netip.MustParseAddr("2001:db8:1::1")}
+	if got := localFamilyCandidates(ips, option{netDialer: familyRemoteDialer{}}); !reflect.DeepEqual(got, ips) {
+		t.Fatal("proxy-controlled egress was filtered", got)
+	}
+}
+
+func TestRouteWeaverLocalFamilyObservationFailureIsUnknown(t *testing.T) {
+	familyFixture(t, false)
+	localFamilyReadInterface = func(string) (LocalFamilySnapshot, error) { return LocalFamilySnapshot{}, errors.New("interface gone") }
+	InvalidateLocalFamily()
+	if got := LocalFamilyDefault(); got.State != "unknown" {
+		t.Fatal(got)
+	}
+}
+
+func TestRouteWeaverLocalFamilyInterfaceScopeAndInvalidation(t *testing.T) {
+	familyFixture(t, true)
+	a := LocalFamilyFor(netip.IPv6Unspecified(), "egress-A")
+	localFamilyObserve(a, netip.MustParseAddr("2001:db8:1::1"), "tcp", nil)
+	if got := LocalFamilyFor(netip.IPv6Unspecified(), "egress-A"); got.State != "local-v6-usable" {
+		t.Fatal(got)
+	}
+	if got := LocalFamilyFor(netip.IPv6Unspecified(), "egress-B"); got.State != "unknown" {
+		t.Fatal("state crossed interfaces", got)
+	}
+	InvalidateLocalFamily()
+	if got := LocalFamilyFor(netip.IPv6Unspecified(), "egress-A"); got.State != "unknown" {
+		t.Fatal("monitor invalidation ignored", got)
+	}
+}
