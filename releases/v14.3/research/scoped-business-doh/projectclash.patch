+	selectExit("TW")
+	expectAnswer(t, systems.Resolver, reused, D.TypeA, "198.51.100.10")
+	tw1 := event(t, twEvents, reused)
+	expectAnswer(t, systems.Resolver, reused, D.TypeAAAA, "2001:db8::10")
+	if got := event(t, twEvents, reused); got.peer != tw1.peer || got.qtype != D.TypeAAAA {
+		t.Fatal("AAAA did not use Taiwan HTTP/2 pool")
+	}
+	expectAnswer(t, systems.Resolver, "fixed.test.", D.TypeA, "198.51.100.9")
+	event(t, jpEvents, "fixed.test.")
+	expectAnswer(t, systems.Resolver, "ipv4only.test.", D.TypeAAAA, "")
+	noEvent(t, jpEvents, twEvents, directEvents)
+	ips, err := R.LookupIPv4WithResolver(context.Background(), reused, systems.ProxyResolver)
+	if err != nil || len(ips) != 1 || ips[0].String() != "198.51.100.88" {
