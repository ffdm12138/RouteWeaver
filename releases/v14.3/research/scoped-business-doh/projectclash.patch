+func TestScopedDoHIPv6(t *testing.T) {
+	listener, err := net.Listen("tcp6", "[::1]:0")
+	if err != nil {
+		t.Skipf("IPv6 loopback unavailable: %v", err)
+	}
+	t.Cleanup(func() { _ = listener.Close() })
+	probe, err := net.DialTimeout("tcp6", listener.Addr().String(), time.Second)
+	if err != nil {
+		t.Skipf("Windows network cannot connect to IPv6 loopback: %v", err)
+	}
+	_ = probe.Close()
+	t.Cleanup(ca.ResetCertificate)
+	upstream, receipts, _ := openEgressOn(t, "10", listener)
+	proxy := adapter.NewProxy(&egressLeg{
+		Base:   outbound.NewBase(outbound.BaseOption{Name: "IPV6", Type: C.Socks5}),
+		socket: upstream.Listener.Addr().String(),
+	})
+	tunnel.UpdateProxies(map[string]C.Proxy{"IPV6": proxy}, nil)
+	t.Cleanup(func() { tunnel.UpdateProxies(map[string]C.Proxy{}, nil) })
+	ok := dns.NewResolver(dns.Config{IPv6: true, Main: []dns.NameServer{
+		{Net: "https", Addr: upstream.URL + "/dns-query", ProxyName: "IPV6", Params: map[string]string{"isolate-egress": "true"}},
+	}})
+	t.Cleanup(ok.ResetConnection)
+	const name = "ipv6.test."
+	expectAnswer(t, ok.Resolver, name, D.TypeA, "198.51.100.10")
+	first := event(t, receipts, name)
+	host, _, err := net.SplitHostPort(first.peer)
+	if err != nil || host != "::1" {
+		t.Fatalf("expected an IPv6 loopback transport: %s %v", first.peer, err)
+	}
+	expectAnswer(t, ok.Resolver, name, D.TypeAAAA, "2001:db8::10")
+	if next := event(t, receipts, name); next.peer != first.peer || next.qtype != D.TypeAAAA {
+		t.Fatalf("AAAA did not use the same IPv6 HTTP/2 connection: %+v", next)
+	}
