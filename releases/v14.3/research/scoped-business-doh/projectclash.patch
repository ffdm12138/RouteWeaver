+	event(t, directEvents, reused)
+	selectExit("JP")
+	expectAnswer(t, systems.Resolver, reused, D.TypeA, "198.51.100.9")
+	event(t, jpEvents, reused)
+	noEvent(t, directEvents, twEvents)
+
+	done := make(chan error, 1)
+	go func() {
+		ctx, cancel := context.WithTimeout(context.Background(), 4*time.Second)
+		defer cancel()
+		_, err := systems.Resolver.ExchangeContext(ctx, new(D.Msg).SetQuestion("pause.test.", D.TypeA))
+		done <- err
