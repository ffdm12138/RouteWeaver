+		name := m.Question[0].Name
+		seen <- name
+		reply := new(D.Msg).SetReply(m)
+		rr, _ := D.NewRR(name + " 60 IN A 198.51.100.88")
+		reply.Answer = []D.RR{rr}
+		_ = w.WriteMsg(reply)
+	})}
+	go func() { _ = srv.ActivateAndServe() }()
+	t.Cleanup(func() { _ = srv.Shutdown(); _ = packet.Close() })
+	return dns.NameServer{Net: "udp", Addr: packet.LocalAddr().String()}, seen
+}
