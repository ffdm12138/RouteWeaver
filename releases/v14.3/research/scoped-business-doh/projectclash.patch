+	event(t, jpEvents, "pause.test.")
+	selectExit("TW")
+	expectAnswer(t, systems.Resolver, "pause.test.", D.TypeA, "198.51.100.10")
+	event(t, twEvents, "pause.test.")
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("in-flight result from old generation succeeded")
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("old HTTP/2 exchange did not end after its pool was retired")
+	}
+	noEvent(t, jpEvents, twEvents, directEvents)
+
+	t.Log("checked same-exit reuse, generation and cache isolation, per-domain policy, A/AAAA over IPv4 loopback, IPv4-only query filter, UDP bootstrap, concrete and rejected exits, and in-flight query isolation")
