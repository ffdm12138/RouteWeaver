+func (d *cDialerInterfaceFinder) DNSInterfaceState() (dialer.DNSInterfaceState, bool) {
+	physical := d.defaultInterfaceMonitor.DefaultInterface()
+	if physical == nil || physical.Name == "" || physical.Name == d.tunName {
+		return dialer.DNSInterfaceState{}, false
+	}
+	return dialer.DNSInterfaceState{Generation: d.dnsInterfaceGeneration.Load(), Name: physical.Name, Index: physical.Index}, true
 }

