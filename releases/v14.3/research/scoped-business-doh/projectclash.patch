diff --git a/dns/egress_doh.go b/dns/egress_doh.go
new file mode 100644
--- /dev/null
+++ b/dns/egress_doh.go
@@ -0,0 +1,297 @@
+package dns
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"hash"
+	"runtime"
+	"sort"
+	"sync"
+	"time"
+
+	"github.com/ProjectClash/Clash/component/resolver"
+	C "github.com/ProjectClash/Clash/constant"
+	"github.com/ProjectClash/Clash/log"
+	"github.com/ProjectClash/Clash/tunnel"
+
+	D "github.com/miekg/dns"
+)
+
+const maxDoHEgressPools = 16
+
+// egressDoH holds a bounded pool per frozen path and generation.
+type egressDoH struct {
+	template *dnsOverHTTPS
+	mu       sync.Mutex
+	pools    map[string]*egressPool
+}
+
+type egressPool struct {
+	route    *tunnel.DNSRouteScope
+	client   *dnsOverHTTPS
+	used     time.Time
+	inFlight int
+}
+
+func newEgressDoH(template *dnsOverHTTPS) *egressDoH {
+	client := &egressDoH{template: template, pools: make(map[string]*egressPool)}
+	runtime.SetFinalizer(client, (*egressDoH).ResetConnection)
+	return client
+}
+
+func (c *egressDoH) Address() string { return c.template.Address() }
+
+func (c *egressDoH) ResetConnection() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for key, entry := range c.pools {
+		entry.client.ResetConnection()
+		delete(c.pools, key)
+	}
+}
+
+func (c *egressDoH) snapshot(domain string) (*tunnel.DNSRouteScope, error) {
+	if c.template.url.Scheme != "https" || c.template.skipCertVerify {
+		return nil, errors.New("egress-isolated DoH requires verified HTTPS")
+	}
+	for _, version := range c.template.httpVersions {
+		if version == C.HTTPVersion3 {
+			return nil, errors.New("egress-isolated DoH prototype does not support HTTP/3")
+		}
+	}
+	return c.template.dialer.SnapshotDNSRoute(domain)
+}
+
+func (c *egressDoH) clientFor(route *tunnel.DNSRouteScope) (*egressPool, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !route.Current() {
+		return nil, tunnel.ErrDNSRouteChanged
+	}
+	for key, entry := range c.pools {
+		if !entry.route.Current() {
+			entry.client.ResetConnection()
+			delete(c.pools, key)
+		}
+	}
+	key := route.Key()
+	entry := c.pools[key]
+	if entry == nil {
+		if len(c.pools) >= maxDoHEgressPools {
+			var oldest *egressPool
+			var oldestKey string
+			for candidateKey, candidate := range c.pools {
+				if candidate.inFlight == 0 && (oldest == nil || candidate.used.Before(oldest.used)) {
+					oldest, oldestKey = candidate, candidateKey
+				}
+			}
+			if oldest == nil {
+				return nil, errors.New("all scoped DoH transports are busy")
+			}
+			oldest.client.ResetConnection()
+			delete(c.pools, oldestKey)
+		}
+		d := c.template
+		active := &dnsOverHTTPS{
+			url: d.url, addr: d.addr, httpVersions: d.httpVersions,
+			dialer:         d.dialer.GuardDNSRoute(route),
+			nameCertVerify: d.nameCertVerify, scopedNoRedirect: true,
+		}
+		runtime.SetFinalizer(active, (*dnsOverHTTPS).Close)
+		entry = &egressPool{route: route, client: active}
+		c.pools[key] = entry
+	}
+	entry.inFlight++
+	entry.used = time.Now()
+	return entry, nil
+}
+
+func (c *egressDoH) release(entry *egressPool) {
+	c.mu.Lock()
+	entry.inFlight--
+	entry.used = time.Now()
+	c.mu.Unlock()
+}
+
+type egressPlanKey struct{}
+type egressPlan map[*egressDoH]*tunnel.DNSRouteScope
+
+func (p egressPlan) current() bool {
+	for _, scope := range p {
+		if !scope.Current() {
+			return false
+		}
+	}
+	return true
+}
+
+func (c *egressDoH) ExchangeContext(ctx context.Context, m *D.Msg) (*D.Msg, error) {
+	p, _ := ctx.Value(egressPlanKey{}).(egressPlan)
+	route := p[c]
+	if route == nil {
+		return nil, errors.New("missing DoH egress plan")
+	}
+	entry, err := c.clientFor(route)
+	if err != nil {
+		return nil, err
+	}
+	defer c.release(entry)
+	answer, err := entry.client.ExchangeContext(ctx, m)
+	if !route.Current() {
+		return nil, tunnel.ErrDNSRouteChanged
+	}
+	return answer, err
+}
+
+func unwrappedEgressClient(client dnsClient) *egressDoH {
+	for {
+		unwrapper, ok := client.(interface{ Unwrap() dnsClient })
+		if !ok {
+			result, _ := client.(*egressDoH)
+			return result
+		}
+		client = unwrapper.Unwrap()
+	}
+}
+
+func writeEgressWrappers(key hash.Hash, client dnsClient) {
+	for {
+		switch wrapped := client.(type) {
+		case clientWithDisableTypes:
+			types := make([]int, 0, len(wrapped.disableTypes))
+			for qtype := range wrapped.disableTypes {
+				types = append(types, int(qtype))
+			}
+			sort.Ints(types)
+			fmt.Fprintf(key, "|types=%v", types)
+			client = wrapped.dnsClient
+		case clientWithEdns0Subnet:
+			fmt.Fprintf(key, "|ecs=%v/%t", wrapped.ecsPrefix, wrapped.ecsOverride)
+			client = wrapped.dnsClient
+		default:
+			return
+		}
+	}
+}
+
+// Each configured upstream gets a bounded share of the exchange deadline.
+// Valid negative answers are terminal. The backup inherits the same route.
+func orderedEgressExchange(ctx context.Context, clients []dnsClient, m *D.Msg) (*D.Msg, error) {
+	plan, _ := ctx.Value(egressPlanKey{}).(egressPlan)
+	var failures []error
+	domain, qtype := msgToDomain(m), D.TypeToString[m.Question[0].Qtype]
+	for i, client := range clients {
+		if !plan.current() {
+			return nil, tunnel.ErrDNSRouteChanged
+		}
+		requestCtx, cancel := context.WithCancel(ctx)
+		if deadline, ok := ctx.Deadline(); ok && i+1 < len(clients) {
+			cancel()
+			requestCtx, cancel = context.WithTimeout(ctx, time.Until(deadline)/time.Duration(len(clients)-i))
+		}
+		log.Debugln("[DNS] resolve %s %s from %s", domain, qtype, client.Address())
+		msg, err := client.ExchangeContext(requestCtx, m)
+		cancel()
+		if err == nil && msg != nil && (msg.Rcode == D.RcodeSuccess || msg.Rcode == D.RcodeNameError) {
+			log.Debugln("[DNS] %s --> %s from %s", domain, msgToLogString(msg), client.Address())
+			return msg, nil
+		}
+		if err == nil {
+			err = errors.New("unusable DNS upstream response")
+		}
+		failures = append(failures, err)
+	}
+	return nil, errors.Join(failures...)
+}
+
+func (r *Resolver) exchangeEgressDoH(ctx context.Context, m *D.Msg) (*D.Msg, error, bool) {
+	clients := r.matchPolicy(m)
+	hasFallback := len(clients) == 0 && isIPRequest(m.Question[0]) && len(r.fallback) != 0
+	if len(clients) == 0 {
+		clients = r.main
+		if hasFallback {
+			for _, client := range r.fallback {
+				if unwrappedEgressClient(client) != nil {
+					return nil, errors.New("egress-isolated DoH does not support fallback DNS lists"), true
+				}
+			}
+		}
+	}
+	var scoped []*egressDoH
+	for _, client := range clients {
+		if doh := unwrappedEgressClient(client); doh != nil {
+			scoped = append(scoped, doh)
+		}
+	}
+	if len(scoped) == 0 {
+		return nil, nil, false
+	}
+	if hasFallback || len(scoped) != len(clients) || m.IsTsig() != nil || len(m.Question) != 1 {
+		return nil, errors.New("unsupported query or mixed upstreams in egress-isolated DoH"), true
+	}
+	copyForKey := m.Copy()
+	copyForKey.Id = 0
+	wire, err := copyForKey.Pack()
+	if err != nil {
+		return nil, err, true
+	}
+	digest := sha256.New()
+	digest.Write(wire)
+	plan := make(egressPlan, len(scoped))
+	policy := scoped[0].template.dialer.DNSPolicy()
+	route, err := scoped[0].snapshot(m.Question[0].Name)
+	if err != nil {
+		return nil, err, true
+	}
+	for i, client := range scoped {
+		if client.template.dialer.DNSPolicy() != policy {
+			return nil, errors.New("scoped DoH primary and backup must use the same policy"), true
+		}
+		plan[client] = route
+		fmt.Fprintf(digest, "|%p|%q", client, route.Key())
+		writeEgressWrappers(digest, clients[i])
+	}
+	key := fmt.Sprintf("egress-doh:%x", digest.Sum(nil))
+	if cached, expires, hit := r.cache.GetWithExpire(key); hit && time.Now().Before(expires) {
+		if !plan.current() {
+			return nil, tunnel.ErrDNSRouteChanged, true
+		}
+		msg := cached.Copy()
+		msg.Id = m.Id
+		updateMsgTTL(msg, uint32(time.Until(expires).Seconds()))
+		return msg, nil, true
+	}
+
+	inflight := r.group.DoChan(key, func() (*D.Msg, error) {
+		if !plan.current() {
+			return nil, tunnel.ErrDNSRouteChanged
+		}
+		exchangeCtx, cancel := context.WithTimeout(context.WithValue(r.queryContext(), egressPlanKey{}, plan),
+			resolver.DefaultDNSTimeout)
+		defer cancel()
+		msg, err := orderedEgressExchange(exchangeCtx, clients, m)
+		if !plan.current() {
+			return nil, tunnel.ErrDNSRouteChanged
+		}
+		if err == nil {
+			putMsgToCacheKey(r.cache, m.Question[0], key, msg)
+		}
+		return msg, err
+	})
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err(), true
+	case result := <-inflight:
+		if !plan.current() {
+			return nil, tunnel.ErrDNSRouteChanged, true
+		}
+		if result.Err != nil {
+			return nil, result.Err, true
+		}
+		msg := result.Val.Copy()
+		msg.Id = m.Id
+		return msg, nil, true
+	}
+}
