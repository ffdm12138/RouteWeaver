new file mode 100644
--- /dev/null
+++ b/config/scoped_doh_test.go
@@ -0,0 +1,28 @@
+package config
+
+import "testing"
+
+func TestScopedDoHParser(t *testing.T) {
+	const endpoint = "routeweaver-doh://dns.alidns.com/dns-query#"
+	upstreams, err := parseNameServer([]string{endpoint + "DNS%26policy%3D1&disable-ipv6=true"}, false, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(upstreams) != 1 {
+		t.Fatalf("parsed %d upstreams", len(upstreams))
+	}
+	upstream := upstreams[0]
+	if upstream.Addr != "https://dns.alidns.com:443/dns-query" || upstream.Net != "https" ||
+		upstream.ProxyName != "DNS&policy=1" || upstream.PreferH3 ||
+		upstream.Params["disable-ipv6"] != "true" || upstream.Params["isolate-egress"] != "true" {
+		t.Fatalf("unexpected scoped upstream: %+v", upstream)
+	}
+	for _, invalid := range []string{
+		endpoint, endpoint + "RULES", endpoint + "DNS&skip-cert-verify=true",
+		"routeweaver-doh://dns.alidns.com:853/dns-query#DNS",
+	} {
+		if _, err := parseNameServer([]string{invalid}, false, false); err == nil {
+			t.Fatalf("accepted invalid scoped upstream %s", invalid)
+		}
+	}
+}
