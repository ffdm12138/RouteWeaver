+	ErrDNSRouteChanged  = errors.New("DNS egress changed during exchange")
+	errUnscopedDNSRoute = errors.New("scoped DoH egress unavailable or unsupported")
+)
+
+type dnsProxyState struct {
+	proxies    map[string]C.Proxy
+	generation uint64
+}
+
+// Called while UpdateProxies holds configMux. The proxy map is immutable.
+func updateDNSProxySnapshot(proxies map[string]C.Proxy) {
+	generation := uint64(1)
+	if previous := dnsProxySnapshot.Load(); previous != nil {
+		generation = previous.generation + 1
+	}
+	dnsProxySnapshot.Store(&dnsProxyState{proxies: proxies, generation: generation})
+}
+
+type dnsSelection interface {
+	DNSSelection() (C.Proxy, uint64)
+}
+
+type dnsBalancer interface {
+	DNSBalancedChoice(*C.Metadata) C.Proxy
+	DNSBalancedChoiceActive(C.Proxy) bool
+}
+
+type DNSRouteScope struct {
+	snapshot            *dnsProxyState
+	root                C.Proxy
+	leaf                C.Proxy
+	path                []C.Proxy
+	key                 string
+	iface               string
+	mark                int32
+	children            map[C.ProxyAdapter]C.Proxy
+	detours             map[string]C.Proxy
+	valid               []func() bool
+	tracksAutoInterface bool
+}
+
+func (s *DNSRouteScope) Key() string { return s.key }
+
+func (s *DNSRouteScope) Current() bool {
+	if dnsProxySnapshot.Load() != s.snapshot || dialer.DefaultInterface.Load() != s.iface ||
+		dialer.DefaultRoutingMark.Load() != s.mark {
+		return false
+	}
+	for _, verify := range s.valid {
+		if !verify() {
+			return false
+		}
+	}
+	return true
+}
+
+func (s *DNSRouteScope) Child(parent C.ProxyAdapter) (C.Proxy, bool) {
+	child, ok := s.children[parent]
+	return child, ok
+}
+
+func (s *DNSRouteScope) Detour(name string) (C.Proxy, bool) {
+	proxy, ok := s.detours[name]
+	return proxy, ok
+}
+
+func (s *DNSRouteScope) matches(chain C.Chain) bool {
+	if len(chain) != len(s.path) {
+		return false
+	}
+	for i, name := range chain {
+		if name != s.path[len(s.path)-1-i].Name() {
+			return false
+		}
+	}
+	return true
+}
+
+func (d *DNSDialer) GuardDNSRoute(scope *DNSRouteScope) *DNSDialer {
+	return &DNSDialer{r: d.r, proxyName: d.proxyName, scope: scope}
+}
+
+func (d *DNSDialer) DNSPolicy() string { return d.proxyName }
+
+func (d *DNSDialer) SnapshotDNSRoute(domain string) (*DNSRouteScope, error) {
+	snapshot := dnsProxySnapshot.Load()
+	if snapshot == nil || d.proxyAdapter != nil || d.proxyName == DnsRespectRules {
+		return nil, errUnscopedDNSRoute
+	}
+	root := snapshot.proxies[d.proxyName]
+	if root == nil {
+		return nil, errUnscopedDNSRoute
+	}
+	route := &DNSRouteScope{snapshot: snapshot, root: root,
+		iface: dialer.DefaultInterface.Load(), mark: dialer.DefaultRoutingMark.Load(),
+		children: make(map[C.ProxyAdapter]C.Proxy), detours: make(map[string]C.Proxy)}
+	var key strings.Builder
+	fmt.Fprintf(&key, "%d|%q|%q|%d", snapshot.generation, d.proxyName, route.iface, route.mark)
+	metadata := &C.Metadata{Type: C.INNER, NetWork: C.TCP, Host: strings.TrimSuffix(domain, ".")}
+	seen := make(map[uintptr]bool)
+	path, err := route.walk(root, metadata, false, seen, &key)
+	if err != nil || len(path) == 0 {
+		return nil, errUnscopedDNSRoute
+	}
+	route.path = path
+	route.leaf = path[len(path)-1]
+	route.key = key.String()
+	return route, nil
+}
+
+// walk freezes built-in proxy-group choices and resolves named dialer-proxy
+// links from the same proxy generation. Unguarded automatic DIRECT is rejected.
+func (s *DNSRouteScope) walk(proxy C.Proxy, metadata *C.Metadata, automatic bool,
+	seen map[uintptr]bool, key *strings.Builder) ([]C.Proxy, error) {
+	value := reflect.ValueOf(proxy)
+	if value.Kind() != reflect.Pointer || value.IsNil() || seen[value.Pointer()] || len(seen) >= 32 {
+		return nil, errUnscopedDNSRoute
+	}
+	id := value.Pointer()
+	seen[id] = true
+	defer delete(seen, id)
+
+	info := proxy.ProxyInfo()
+	fmt.Fprintf(key, "|%x/%q/%q/%d", id, proxy.Name(), info.Interface, info.RoutingMark)
+	adapter := proxy.Adapter()
+	var next C.Proxy
+	switch proxy.Type() {
+	case C.Selector, C.URLTest, C.Fallback:
+		selected, ok := adapter.(dnsSelection)
+		if !ok {
+			return nil, errUnscopedDNSRoute
+		}
+		var generation uint64
+		next, generation = selected.DNSSelection()
+		if next == nil {
+			return nil, errUnscopedDNSRoute
+		}
+		fmt.Fprintf(key, "/%d", generation)
+		chosen := next
+		s.valid = append(s.valid, func() bool {
+			current, currentGeneration := selected.DNSSelection()
+			return current == chosen && currentGeneration == generation
+		})
+		automatic = automatic || proxy.Type() != C.Selector
+	case C.LoadBalance:
+		group, ok := adapter.(dnsBalancer)
+		if !ok {
+			return nil, errUnscopedDNSRoute
+		}
+		next = s.children[adapter]
+		if next == nil {
+			next = group.DNSBalancedChoice(metadata)
+		}
+		if next == nil || !group.DNSBalancedChoiceActive(next) {
+			return nil, errUnscopedDNSRoute
+		}
+		chosen := next
+		s.valid = append(s.valid, func() bool { return group.DNSBalancedChoiceActive(chosen) })
+		automatic = true
+	case C.Direct:
+		if automatic {
+			return nil, errUnscopedDNSRoute
+		}
+	case C.Reject, C.RejectDrop, C.Shadowsocks, C.ShadowsocksR, C.Snell,
+		C.Socks5, C.Http, C.Vmess, C.Vless, C.Trojan, C.Hysteria, C.Hysteria2,
+		C.WireGuard, C.Tuic, C.Ssh, C.Mieru, C.AnyTLS, C.Sudoku, C.Masque,
+		C.TrustTunnel, C.ShadowQuic, C.OpenVPN, C.Tailscale, C.ZeroTier,
+		C.EasyTier, C.GostRelay:
+		// Stable adapter identity suffices when there is no dynamic underlay.
+	default:
+		return nil, errUnscopedDNSRoute
+	}
+	if next != nil {
+		if seenChild, exists := s.children[adapter]; exists && seenChild != next {
+			return nil, errUnscopedDNSRoute
+		}
+		s.children[adapter] = next
+		rest, err := s.walk(next, metadata, automatic, seen, key)
+		return append([]C.Proxy{proxy}, rest...), err
+	}
+
+	if info.DialerProxy != "" {
+		fresh, ok := adapter.(interface{ DNSFreshDetour() bool })
+		if info.SMUX || (proxy.Type() != C.Socks5 && proxy.Type() != C.Http && (!ok || !fresh.DNSFreshDetour())) {
+			return nil, errUnscopedDNSRoute
+		}
+		underlay := s.snapshot.proxies[info.DialerProxy]
+		underlayMeta := &C.Metadata{Type: C.INNER, NetWork: C.TCP}
+		if underlay == nil || underlayMeta.SetRemoteAddress(proxy.Addr()) != nil {
+			return nil, errUnscopedDNSRoute
+		}
+		fmt.Fprintf(key, "|via:%q", info.DialerProxy)
+		s.detours[info.DialerProxy] = underlay
+		if _, err := s.walk(underlay, underlayMeta, false, seen, key); err != nil {
+			return nil, err
+		}
+	} else if proxy.Type() != C.Reject && proxy.Type() != C.RejectDrop &&
+		info.Interface == "" && s.iface == "" && !s.trackInterface(key) {
+		return nil, errUnscopedDNSRoute
+	}
+	return []C.Proxy{proxy}, nil
+}
+
+func (s *DNSRouteScope) trackInterface(key *strings.Builder) bool {
+	if s.tracksAutoInterface {
+		return true
+	}
+	finder := dialer.DefaultInterfaceFinder.Load()
+	if finder == nil {
+		s.valid = append(s.valid, func() bool { return dialer.DefaultInterfaceFinder.Load() == nil })
+	} else {
+		scoped, ok := finder.(dialer.DNSInterfaceFinder)
+		if !ok || reflect.ValueOf(scoped).Kind() != reflect.Pointer || reflect.ValueOf(scoped).IsNil() {
+			return false
+		}
+		state, available := scoped.DNSInterfaceState()
+		if !available {
+			return false
+		}
+		fmt.Fprintf(key, "|interface:%p/%d/%q/%d", scoped, state.Generation, state.Name, state.Index)
+		s.valid = append(s.valid, func() bool {
+			if dialer.DefaultInterfaceFinder.Load() != finder {
+				return false
+			}
+			current, available := scoped.DNSInterfaceState()
+			return available && current == state
+		})
+	}
+	s.tracksAutoInterface = true
+	return true
+}
