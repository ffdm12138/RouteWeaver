+)
+
+type egressLeg struct {
+	*outbound.Base
+	socket string
+}
+
+func (e *egressLeg) DialContext(ctx context.Context, _ *C.Metadata) (C.Conn, error) {
+	if e.socket == "" {
+		return nil, errors.New("fixture outbound offline")
+	}
+	var dialer net.Dialer
+	conn, err := dialer.DialContext(ctx, "tcp", e.socket)
+	if err != nil {
+		return nil, err
+	}
+	return outbound.NewConn(conn, e), nil
+}
+
+type dohEvent struct {
+	name, peer, protocol string
+	qtype                uint16
+	path                 string
+}
+
+func openEgress(t *testing.T, suffix string) (*httptest.Server, chan dohEvent, chan struct{}) {
+	t.Helper()
+	return openEgressOn(t, suffix, nil)
+}
+
+func openEgressOn(t *testing.T, suffix string, listener net.Listener) (*httptest.Server, chan dohEvent, chan struct{}) {
+	t.Helper()
+	events := make(chan dohEvent, 48)
+	release := make(chan struct{})
+	upstream := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, request *http.Request) {
+		var query D.Msg
+		body, err := base64.RawURLEncoding.DecodeString(request.URL.Query().Get("dns"))
+		if request.Method != http.MethodGet || err != nil || query.Unpack(body) != nil ||
+			len(query.Question) != 1 || (request.URL.Path != "/dns-query" && request.URL.Path != "/backup-query") {
+			w.WriteHeader(400)
+			return
+		}
+		question := query.Question[0]
+		events <- dohEvent{question.Name, request.RemoteAddr, request.Proto, question.Qtype, request.URL.Path}
+		if strings.HasPrefix(question.Name, "backup.") && request.URL.Path == "/dns-query" {
+			w.WriteHeader(503)
+			return
+		}
+		if strings.HasPrefix(question.Name, "pause.") && suffix == "9" {
+			select {
+			case <-release:
+			case <-request.Context().Done():
+				return
+			}
+		}
+		answer := new(D.Msg).SetReply(&query)
+		answer.RecursionAvailable = true
+		ip := "198.51.100." + suffix
+		if question.Qtype == D.TypeAAAA {
+			ip = "2001:db8::" + suffix
+		}
+		record, err := D.NewRR(question.Name + " 90 IN " + D.TypeToString[question.Qtype] + " " + ip)
+		if err != nil {
+			w.WriteHeader(400)
+			return
+		}
+		answer.Answer = []D.RR{record}
+		wire, err := answer.Pack()
+		if err != nil {
+			w.WriteHeader(500)
+			return
+		}
+		w.Header().Set("Content-Type", "application/dns-message")
+		_, _ = w.Write(wire)
+	}))
+	if listener != nil {
+		_ = upstream.Listener.Close()
+		upstream.Listener = listener
+	}
+	upstream.EnableHTTP2 = true
+	upstream.StartTLS()
+	t.Cleanup(upstream.Close)
+	if err := ca.AddCertificate(string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: upstream.Certificate().Raw}))); err != nil {
+		t.Fatal(err)
+	}
+	return upstream, events, release
+}
+
+func mockSelector(t *testing.T, name string, reject C.Proxy, choices ...C.Proxy) *outboundgroup.Selector {
+	t.Helper()
+	hc := provider.NewHealthCheck(choices, "", 1000, 0, true, nil)
+	source, err := provider.NewCompatibleProvider(name, choices, hc)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = source.Close() })
+	selector, err := outboundgroup.NewSelector(outboundgroup.GroupCommonOption{Name: name},
+		outboundgroup.SelectorOption{}, reject, []P.ProxyProvider{source})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return selector
+}
+
+func exchange(t *testing.T, res *dns.Resolver, name string, qtype uint16) (*D.Msg, error) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 4*time.Second)
+	defer cancel()
+	return res.ExchangeContext(ctx, new(D.Msg).SetQuestion(name, qtype))
+}
+
+func expectAnswer(t *testing.T, res *dns.Resolver, name string, qtype uint16, expect string) {
+	t.Helper()
+	answer, err := exchange(t, res, name, qtype)
+	if err != nil || answer == nil || answer.Rcode != 0 {
+		t.Fatalf("%s unexpected DNS result: %v, %v", name, answer, err)
+	}
+	if expect == "" && len(answer.Answer) == 0 {
+		return
+	}
+	if len(answer.Answer) != 1 || !strings.HasSuffix(answer.Answer[0].String(), "\t"+expect) {
+		t.Fatalf("%s %v, want %s", name, answer.Answer, expect)
+	}
+}
+
+func event(t *testing.T, channel chan dohEvent, name string) dohEvent {
+	t.Helper()
+	select {
+	case e := <-channel:
+		if e.name != name || e.protocol != "HTTP/2.0" {
+			t.Fatalf("unexpected resolver receipt: %+v", e)
+		}
+		t.Logf("%s qtype=%d peer=%s %s", e.name, e.qtype, e.peer, e.protocol)
+		return e
+	case <-time.After(700 * time.Millisecond):
+		t.Fatalf("resolver did not receive %s", name)
+		return dohEvent{}
+	}
+}
+
+func noEvent(t *testing.T, channels ...chan dohEvent) {
+	t.Helper()
+	for _, ch := range channels {
+		select {
+		case e := <-ch:
+			t.Fatalf("unexpected resolver traffic: %+v", e)
+		default:
+		}
+	}
+}
+
+func bootstrap(t *testing.T) (dns.NameServer, chan string) {
+	t.Helper()
+	packet, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	seen := make(chan string, 8)
+	srv := &D.Server{PacketConn: packet, Handler: D.HandlerFunc(func(w D.ResponseWriter, m *D.Msg) {
+		name := m.Question[0].Name
+		seen <- name
+		reply := new(D.Msg).SetReply(m)
+		rr, _ := D.NewRR(name + " 60 IN A 198.51.100.88")
+		reply.Answer = []D.RR{rr}
+		_ = w.WriteMsg(reply)
+	})}
+	go func() { _ = srv.ActivateAndServe() }()
+	t.Cleanup(func() { _ = srv.Shutdown(); _ = packet.Close() })
+	return dns.NameServer{Net: "udp", Addr: packet.LocalAddr().String()}, seen
+}
+
