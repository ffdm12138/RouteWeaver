+package constant
+
+import (
+	"context"
+	"errors"
+)
+
+var ErrUnpinnedDNSEgress = errors.New("DNS dial outside the selected egress")
+
+// DNSEgressPlan confines a DNS dial and its nested detours to the choices made
+// before the query was admitted to a connection pool or answer cache.
+type DNSEgressPlan interface {
+	Child(ProxyAdapter) (Proxy, bool)
+	Detour(string) (Proxy, bool)
+}
+
+type dnsEgressContextKey struct{}
+
+func WithDNSEgressPlan(ctx context.Context, plan DNSEgressPlan) context.Context {
+	return context.WithValue(ctx, dnsEgressContextKey{}, plan)
+}
+
+func DNSEgressPlanFrom(ctx context.Context) DNSEgressPlan {
+	plan, _ := ctx.Value(dnsEgressContextKey{}).(DNSEgressPlan)
+	return plan
+}
