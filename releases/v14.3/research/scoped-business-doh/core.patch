+func TestScopedDoHAutomaticFallback(t *testing.T) {
+	t.Cleanup(ca.ResetCertificate)
+	trap, directEvents, _ := openEgress(t, "11")
+	jp, jpEvents, _ := openEgress(t, "9")
+	tw, twEvents, _ := openEgress(t, "10")
+	reject := adapter.NewProxy(outbound.NewReject())
+	direct := adapter.NewProxy(outbound.NewDirect())
+	j := healthFixture(adapter.NewProxy(&egressLeg{Base: outbound.NewBase(outbound.BaseOption{Name: "JP", Type: C.Socks5}), socket: jp.Listener.Addr().String()}))
+	w := healthFixture(adapter.NewProxy(&egressLeg{Base: outbound.NewBase(outbound.BaseOption{Name: "TW", Type: C.Socks5}), socket: tw.Listener.Addr().String()}))
+	choices := []C.Proxy{j, w, direct}
+	source, err := provider.NewCompatibleProvider("automatic", choices, provider.NewHealthCheck(choices, "", 1000, 0, true, nil))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = source.Close() })
+	selector, err := outboundgroup.NewFallback(outboundgroup.GroupCommonOption{Name: "AUTO"}, outboundgroup.FallbackOption{}, reject, []P.ProxyProvider{source})
+	if err != nil {
+		t.Fatal(err)
+	}
+	tunnel.UpdateProxies(map[string]C.Proxy{"AUTO": adapter.NewProxy(selector)}, nil)
+	t.Cleanup(func() { tunnel.UpdateProxies(map[string]C.Proxy{}, nil) })
+	config := dns.Config{IPv6: true, Main: []dns.NameServer{
+		{Net: "https", Addr: trap.URL + "/dns-query", ProxyName: "AUTO", Params: map[string]string{"isolate-egress": "true"}},
+		{Net: "https", Addr: trap.URL + "/backup-query", ProxyName: "AUTO", Params: map[string]string{"isolate-egress": "true"}},
+	}}
+	res := dns.NewResolver(config)
+	t.Cleanup(res.ResetConnection)
+	const name = "fallback.test."
+	expectAnswer(t, res.Resolver, name, D.TypeA, "198.51.100.9")
+	entry := event(t, jpEvents, name)
+	if entry.path != "/dns-query" {
+		t.Fatalf("backup was used first: %+v", entry)
+	}
+	noEvent(t, jpEvents, twEvents, directEvents)
+
+	j.setAlive(false)
+	j.setAlive(true)
+	expectAnswer(t, res.Resolver, name, D.TypeA, "198.51.100.9")
+	recovered := event(t, jpEvents, name)
+	if recovered.peer == entry.peer {
+		t.Fatal("pre-outage connection or cache was reused after recovery")
+	}
+	j.setAlive(false)
+	expectAnswer(t, res.Resolver, name, D.TypeA, "198.51.100.10")
+	event(t, twEvents, name)
+	expectAnswer(t, res.Resolver, "backup.order.test.", D.TypeA, "198.51.100.10")
+	if e := event(t, twEvents, "backup.order.test."); e.path != "/dns-query" {
+		t.Fatalf("primary was not tried first: %+v", e)
+	}
+	if e := event(t, twEvents, "backup.order.test."); e.path != "/backup-query" {
+		t.Fatalf("backup was not tried after primary failed: %+v", e)
+	}
+	j.setAlive(true)
+	expectAnswer(t, res.Resolver, name, D.TypeA, "198.51.100.9")
+	if e := event(t, jpEvents, name); e.peer == recovered.peer {
+		t.Fatal("old automatic generation was reused")
+	}
+	j.setAlive(false)
+	w.setAlive(false)
+	if msg, err := exchange(t, res.Resolver, name, D.TypeA); err == nil || msg != nil {
+		t.Fatal("automatic DIRECT or old cache was accepted")
+	}
+	noEvent(t, jpEvents, twEvents, directEvents)
+}
