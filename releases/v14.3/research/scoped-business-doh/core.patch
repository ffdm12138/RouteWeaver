+	if err != nil || len(ips) != 1 || ips[0].String() != "198.51.100.88" {
+		t.Fatalf("bootstrap resolver: %v %v", ips, err)
+	}
+	if got := <-bootEvents; got != reused {
+		t.Fatalf("bootstrap got %s", got)
+	}
+	noEvent(t, jpEvents, twEvents, directEvents)
+
+	selectExit("JP")
+	expectAnswer(t, systems.Resolver, reused, D.TypeA, "198.51.100.9")
+	jp2 := event(t, jpEvents, reused)
+	if jp2.peer == jp1.peer {
+		t.Fatal("old Japan generation was reused")
+	}
+	tunnel.UpdateProxies(proxies, nil)
+	expectAnswer(t, systems.Resolver, reused, D.TypeA, "198.51.100.9")
+	if got := event(t, jpEvents, reused); got.peer == jp2.peer {
+		t.Fatal("old configuration generation was reused")
+	}
+
+	for _, exit := range []string{"OFFLINE", "REJECT"} {
+		selectExit(exit)
+		for _, name := range []string{reused, "uncached.test."} {
+			if msg, err := exchange(t, systems.Resolver, name, D.TypeA); err == nil || msg != nil {
+				t.Fatalf("fail-closed %s %s returned %v, %v", exit, name, msg, err)
+			}
+		}
+	}
+	noEvent(t, jpEvents, twEvents, directEvents)
+
+	selectExit("DIRECT")
+	expectAnswer(t, systems.Resolver, reused, D.TypeA, "198.51.100.11")
+	event(t, directEvents, reused)
+	selectExit("JP")
+	expectAnswer(t, systems.Resolver, reused, D.TypeA, "198.51.100.9")
+	event(t, jpEvents, reused)
+	noEvent(t, directEvents, twEvents)
+
+	done := make(chan error, 1)
+	go func() {
+		ctx, cancel := context.WithTimeout(context.Background(), 4*time.Second)
+		defer cancel()
+		_, err := systems.Resolver.ExchangeContext(ctx, new(D.Msg).SetQuestion("pause.test.", D.TypeA))
+		done <- err
+	}()
+	event(t, jpEvents, "pause.test.")
+	selectExit("TW")
+	expectAnswer(t, systems.Resolver, "pause.test.", D.TypeA, "198.51.100.10")
+	event(t, twEvents, "pause.test.")
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("in-flight result from old generation succeeded")
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("old HTTP/2 exchange did not end after its pool was retired")
+	}
+	noEvent(t, jpEvents, twEvents, directEvents)
+
+	t.Log("checked same-exit reuse, generation and cache isolation, per-domain policy, A/AAAA over IPv4 loopback, IPv4-only query filter, UDP bootstrap, concrete and rejected exits, and in-flight query isolation")
+}
