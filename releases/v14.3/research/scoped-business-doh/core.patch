+func dnsChild(ctx context.Context, parent C.ProxyAdapter, touch func(), ordinary func() C.Proxy) (C.Proxy, error) {
+	if plan := C.DNSEgressPlanFrom(ctx); plan != nil {
+		if child, ok := plan.Child(parent); ok {
+			touch()
+			return child, nil
+		}
+		return nil, C.ErrUnpinnedDNSEgress
+	}
+	return ordinary(), nil
+}
