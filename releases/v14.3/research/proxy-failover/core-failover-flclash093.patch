+}
+
+func (p *routeWeaverTestProxy) Name() string { return p.name }
+
+func TestRouteWeaverFailoverPriority(t *testing.T) {
+	a := &routeWeaverTestProxy{name: "A"}
+	b := &routeWeaverTestProxy{name: "B"}
+	bRefreshed := &routeWeaverTestProxy{name: "B"}
+	c := &routeWeaverTestProxy{name: "C"}
+	reject := &routeWeaverTestProxy{name: "REJECT"}
+	f := &RouteWeaverFailover{reject: reject, wake: make(chan struct{}, 1), nodes: map[C.Proxy]*routeWeaverHealth{
+		a: {down: true},
+		b: {readyUntil: time.Now().Add(time.Minute)},
+		c: {readyUntil: time.Now().Add(time.Minute)},
+	}}
+	for _, step := range []struct {
+		primary C.Proxy
+		backups [RouteWeaverBackupCount]C.Proxy
+		want    C.Proxy
+		slot    int
+	}{
+		{a, [3]C.Proxy{b, c, nil}, b, 0},
+		{a, [3]C.Proxy{bRefreshed, c, reject}, c, 1},
+		{a, [3]C.Proxy{a, nil, c}, c, 2},
+		{a, [3]C.Proxy{reject, nil, bRefreshed}, a, -1},
+		{nil, [3]C.Proxy{nil, b, c}, b, 1},
+		{nil, [3]C.Proxy{nil, bRefreshed, reject}, reject, -1},
+	} {
+		if node, slot := f.pick(step.primary, step.backups); node != step.want || slot != step.slot {
+			t.Fatalf("got %v via slot %d, want %v via slot %d", node, slot, step.want, step.slot)
+		}
+	}
+	f.nodes[a].down = false
+	if node, _ := f.pick(a, [3]C.Proxy{b, c, nil}); node != a {
+		t.Fatal("did not restore the primary")
+	}
+}
