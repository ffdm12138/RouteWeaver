+package tunnel
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"syscall"
+	"testing"
+
+	"github.com/metacubex/mihomo/component/loopback"
+	"github.com/metacubex/mihomo/component/resolver"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestRouteWeaverRetryClassification(t *testing.T) {
+	tests := []struct {
+		name string
+		err  error
+		stop bool
+	}{
+		{"marked direct IPv6", fmt.Errorf("%w: %w", C.ErrDirectIPv6NetworkUnreachable, syscall.ENETUNREACH), true},
+		{"unmarked proxy network error", syscall.ENETUNREACH, false},
+		{"timeout unchanged", context.DeadlineExceeded, false},
+		{"IP missing", resolver.ErrIPNotFound, true},
+		{"IP version", resolver.ErrIPVersion, true},
+		{"IPv6 disabled", resolver.ErrIPv6Disabled, true},
+		{"loopback reject", loopback.ErrReject, true},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := shouldStopRetry(test.err); got != test.stop {
+				t.Fatalf("shouldStopRetry=%v, want %v", got, test.stop)
+			}
+		})
+	}
+}
+
+func TestRouteWeaverRetryCounts(t *testing.T) {
+	for _, marked := range []bool{true, false} {
+		name := "unmarked proxy error keeps ten attempts"
+		want := 10
+		err := error(syscall.ENETUNREACH)
+		if marked {
+			name = "marked direct error stops after one attempt"
+			want = 1
+			err = fmt.Errorf("%w: %w", C.ErrDirectIPv6NetworkUnreachable, err)
+		}
+		t.Run(name, func(t *testing.T) {
+			attempts, warnings := 0, 0
+			_, got := retry(context.Background(), func(context.Context) (int, error) {
+				attempts++
+				return 0, err
+			}, func(error) { warnings++ })
+			if attempts != want || warnings != want || !errors.Is(got, syscall.ENETUNREACH) {
+				t.Fatalf("attempts=%d warnings=%d error=%v; want %d", attempts, warnings, got, want)
+			}
+		})
+	}
+	attempts := 0
+	got, err := retry(context.Background(), func(context.Context) (int, error) {
+		attempts++
+		return 42, nil
+	}, nil)
+	if attempts != 1 || got != 42 || err != nil {
+		t.Fatalf("successful new connection affected: %d %d %v", attempts, got, err)
+	}
+}
