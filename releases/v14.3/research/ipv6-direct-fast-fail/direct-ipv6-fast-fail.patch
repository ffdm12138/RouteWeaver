+	"golang.org/x/sys/windows"
+)
+
+func TestRouteWeaverWindowsWinsock(t *testing.T) {
+	metadata := &C.Metadata{NetWork: C.TCP, DstIP: netip.MustParseAddr("2001:db8::42"), DstPort: 443}
+	err := &net.OpError{Op: "dial", Net: "tcp", Err: &os.SyscallError{Syscall: "connectex", Err: windows.WSAENETUNREACH}}
+	got := NewDirect().directIPv6DialError(metadata, err)
+	if !errors.Is(got, C.ErrDirectIPv6NetworkUnreachable) || !errors.Is(got, windows.WSAENETUNREACH) {
+		t.Fatalf("Winsock network-unreachable not preserved and marked: %v", got)
+	}
+	if got := NewDirect().directIPv6DialError(metadata, windows.WSAEHOSTUNREACH); errors.Is(got, C.ErrDirectIPv6NetworkUnreachable) {
+		t.Fatalf("host-unreachable incorrectly classified: %v", got)
+	}
+}
