+package outbound
+
+import (
+	"fmt"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+// Only mark literal TCP destinations actually used by native DIRECT. A Host
+// takes precedence over DstIP in RemoteAddress, so a cached DstIP alone cannot
+// establish the family dialed for a hostname. No failures are cached across
+// connections; the next connection can succeed after a route change.
+func (d *Direct) directIPv6DialError(metadata *C.Metadata, err error) error {
+	if err == nil || d.Type() != C.Direct || metadata == nil || metadata.NetWork != C.TCP || metadata.Type == C.INNER || metadata.Host != "" ||
+		!metadata.DstIP.Unmap().Is6() || !isDirectNetworkUnreachable(err) {
+		return err
+	}
+	return fmt.Errorf("%w: %w", C.ErrDirectIPv6NetworkUnreachable, err)
+}
