+package constant
+
+import "errors"
+
+// ErrDirectIPv6NetworkUnreachable marks an OS network-unreachable error for a
+// literal IPv6 TCP dial by the native DIRECT adapter. It does not change policy
+// or imply that an equivalent IPv4 destination exists.
+var ErrDirectIPv6NetworkUnreachable = errors.New("direct IPv6 network unreachable")
